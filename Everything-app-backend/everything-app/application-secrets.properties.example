# ============================================================================
# Lokale Entwicklungs-Geheimnisse. NICHT eingecheckt (siehe .gitignore).
#
# Liegt neben der pom.xml, NICHT in src/main/resources - sonst waere sie in jedem
# lokal gebauten Jar enthalten. Geladen ueber spring.config.import in
# application.properties, relativ zum Arbeitsverzeichnis von ./mvnw spring-boot:run.
#
# Vorlage: application-secrets.properties.example
# In Produktion existiert diese Datei nicht - der Import ist "optional:", und
# application-prod.properties holt beide Werte aus der Umgebung.
# ============================================================================

# Lokale Dev-Postgres (angelegt am 2026-08-07, Rolle+DB "everything_app")
spring.datasource.password=DEIN_LOKALES_DB_PASSWORT

# Dev-Secret, lokal generiert - nicht der Produktiv-Key
jwt.secret=MIT_openssl_rand_-base64_48_ERZEUGEN
