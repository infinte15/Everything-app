# ===========================================================================
# Vorlage fuer .env neben der compose.yaml.
#
#   cp .env.example .env && chmod 600 .env
#
# .env selbst ist in .gitignore. Sie gehoert zusammen mit dem Android-Keystore,
# dem PSD2-Schluessel und den Tunnel-Credentials ins Backup (Kapitel 8.6) -
# diese vier aendern sich fast nie und werden deshalb gern vergessen.
# ===========================================================================

# ---- Datenbank ------------------------------------------------------------
DB_USER=everything_app
# openssl rand -base64 24
DB_PASSWORD=

# ---- Auth -----------------------------------------------------------------
# openssl rand -base64 48
# HS256 braucht mindestens 32 Byte, sonst wirft der Start.
JWT_SECRET=

# Token-Laufzeit in Millisekunden, Vorgabe 30 Tage (2592000000).
# Ein verlorenes Geraet muss man deshalb nicht aussitzen: POST /api/auth/logout-all
# entwertet alle bisher ausgegebenen Token. Kuerzere Laufzeit z.B. 7 Tage = 604800000.
JWT_EXPIRATION=2592000000

# Beim ALLERERSTEN Start einmal auf true setzen, den eigenen Account ueber
# POST /api/auth/register anlegen, dann zurueck auf false und
#   docker compose up -d backend
APP_REGISTRATION_ENABLED=false

# ---- Domain ---------------------------------------------------------------
# Ohne Schema. Fliesst in enablebanking.redirect-url und in die Client-Builds.
APP_DOMAIN=app.deine-domain.de

# ---- Cloudflare Tunnel ----------------------------------------------------
# Zero Trust → Networks → Tunnels → Tunnel anlegen → Token kopieren.
CF_TUNNEL_TOKEN=

# ---- Backup ---------------------------------------------------------------
# Eigener Mountpoint (externe USB-Platte), NICHT die Systemplatte: dort liegt das
# pgdata-Volume, und ein Plattenausfall naehme sonst Datenbank und Backup zugleich.
# ea-backup.sh bricht ab, wenn hier nichts eingehaengt ist - und damit auch deploy.sh.
# Das ist gewollt, solange ddl-auto=update laeuft.
BACKUP_MOUNT=/mnt/backup
BACKUP_KEEP_DAYS=30

# ---- Bankanbindung --------------------------------------------------------
# "demo" liefert Beispieldaten ohne Zugangsdaten. Auf "live" erst umstellen,
# wenn Application-ID und Schluessel vorliegen.
EB_PROVIDER=demo
EB_APP_ID=
# Absoluter Pfad auf dem SERVER zum PKCS#8-PEM. Bleibt der Provider auf "demo",
# kann der Standard /dev/null stehen bleiben.
EB_PRIVATE_KEY_PATH=/dev/null
